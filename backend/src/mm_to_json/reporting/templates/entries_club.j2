{% extends "_base_report.j2" %}

{% block extra_css %}
    .content-container {
        column-count: 1;
    }
    .athlete-block {
        margin-bottom: 15pt;
        border-bottom: 1pt solid #eee;
        padding-bottom: 8pt;
        break-inside: avoid;
        page-break-inside: avoid;
    }
    .athlete-name {
        font-size: 11pt;
        font-weight: bold;
        margin-bottom: 4pt;
        color: #333;
    }
    .entries-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9pt;
    }
    .entries-table th {
        text-align: left;
        border-bottom: 1px solid #ddd;
        padding: 2pt;
        font-size: 8pt;
        color: #666;
    }
    .entries-table td {
        padding: 3pt 2pt;
        vertical-align: top;
    }
    .col-ev { width: 30pt; }
    .col-desc { width: auto; }
    .col-time { width: 60pt; text-align: right; }
    
    .relay-swimmers {
        margin-top: 2pt;
        padding-left: 10pt;
    }
{% endblock %}

{% block content %}
    {% for group in groups %}
    <div class="athlete-block">
        <div class="athlete-name">{{ group.header }}</div>
        {% for athlete_group in group.sub_items %}
        <div class="athlete-info" style="margin-top: 10pt; margin-bottom: 5pt; font-weight: bold; border-bottom: 1px solid #ccc; padding-bottom: 2pt;">
            {{ athlete_group.header }}
        </div>
        <table class="entries-table">
            <thead>
                <tr>
                    <th class="col-ev">Ev#</th>
                    <th class="col-desc">Event Description</th>
                    <th class="col-time">Entry Time</th>
                </tr>
            </thead>
            <tbody>
                {% for event in athlete_group.sub_items %}
                <tr>
                    <td class="col-ev">#{{ event.event_num }}</td>
                    <td>
                        {{ event.event_name }}
                        {% if event.is_relay and event.swimmers %}
                        <div class="relay-swimmers">
                            <div class="relay-swimmers-grid" style="display: table; width: 100%; table-layout: fixed; margin-top: 2pt; font-size: 8pt; line-height: 1.0; color: #444;">
                                <div class="relay-col" style="display: table-cell; width: 50%; vertical-align: top;">
                                    <div class="relay-swimmer-container" style="display: table; width: 100%; table-layout: fixed; padding-right: 4pt;">
                                        <div class="relay-swimmer-name" style="display: table-cell; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">1) {{ event.swimmers[0] if event.swimmers|length > 0 else '' }}</div>
                                    </div>
                                    <div class="relay-swimmer-container" style="display: table; width: 100%; table-layout: fixed; padding-right: 4pt;">
                                        <div class="relay-swimmer-name" style="display: table-cell; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">3) {{ event.swimmers[2] if event.swimmers|length > 2 else '' }}</div>
                                    </div>
                                </div>
                                <div class="relay-col" style="display: table-cell; width: 50%; vertical-align: top;">
                                    <div class="relay-swimmer-container" style="display: table; width: 100%; table-layout: fixed; padding-right: 4pt;">
                                        <div class="relay-swimmer-name" style="display: table-cell; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">2) {{ event.swimmers[1] if event.swimmers|length > 1 else '' }}</div>
                                    </div>
                                    <div class="relay-swimmer-container" style="display: table; width: 100%; table-layout: fixed; padding-right: 4pt;">
                                        <div class="relay-swimmer-name" style="display: table-cell; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">4) {{ event.swimmers[3] if event.swimmers|length > 3 else '' }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    </td>
                    <td class="col-time">{{ event.time }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endfor %}
    </div>
    {% endfor %}
{% endblock %}
