<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ meet_name }} - {{ sub_title }}</title>
    <style>
        /* Base injection for mm-tools styles */
        {{ css_content }}

        /* Optional column configuration applied globally if specified */
        {% if columns_on_page and columns_on_page > 1 %}
        .content-container {
            column-count: {{ columns_on_page }};
            column-gap: 20pt;
        }
        {% endif %}
        
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    <div id="header" class="header-container">
        <div class="header-top">
            <span class="left">MM-Tools Report</span>
            <span class="right">Generated: {{ generation_time }}</span>
        </div>
        <div class="header-main">
            <h1 class="report-title">{{ meet_name }}</h1>
            <h2 class="meet-info">{{ sub_title }}</h2>
        </div>
    </div>

    <!-- Main Report Content -->
    <div class="content-container {% block container_class %}{% endblock %}">
        {% block content %}{% endblock %}
    </div>
</body>
</html>
