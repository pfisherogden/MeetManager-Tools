<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ meet_name }} - {{ sub_title }}</title>
    <style>
        /* Base injection for mm-tools styles */
        {{ css_content }}

        /* Centralized column configuration */
        {% if columns_on_page and columns_on_page > 1 %}
        .content-container {
            column-count: {{ columns_on_page }};
            column-gap: 25pt;
            column-rule: 0.5pt solid #eee;
            column-fill: auto;
        }
        {% endif %}
        
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    <div id="header" class="header-container">
        <div class="header-top">
            <div class="header-left">
                <div class="header-meet-name">{{ meet_name|default('Tri-Valley Swim League') }}</div>
                <div class="header-sub-title">{{ sub_title }}</div>
            </div>
            <div class="header-right">
                <div class="header-timestamp">MM-Tools - {{ generation_time }}</div>
                <div class="header-page-num">Page <span class="page-counter"></span></div>
            </div>
        </div>
    </div>

    <!-- Main Report Content -->
    <div class="content-container {% block container_class %}{% endblock %}">
        {% block content %}{% endblock %}
    </div>
</body>
</html>
