<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ meet_name }} - {{ sub_title }}</title>
    <style>
        /* Base injection for mm-tools styles */
        {{ css_content }}

        /* Centralized column configuration */
        {% if columns_on_page and columns_on_page > 1 %}
        .content-container {
            column-count: {{ columns_on_page }};
            column-gap: 30pt;
            column-rule: 1pt solid #ddd;
            column-fill: auto;
        }
        {% endif %}
        
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    {% if not playwright %}
    <div id="header">
        <table class="header-table">
            <tr class="header-top">
                <td class="header-left-col">
                    <div class="header-meet-name">Tri-Valley Swim Lg. C</div>
                </td>
                <td class="header-right-col">
                    <div class="header-software">HY-TEK's MEET MANAGER 7.0 - {{ generation_time }} Page <span class="page-counter"></span></div>
                </td>
            </tr>
            <tr>
                <td class="header-left-col">
                    <div class="header-meet-info">{{ meet_name }}</div>
                </td>
                <td class="header-right-col">
                </td>
            </tr>
            <tr>
                <td class="header-left-col">
                    <div class="header-sub-title">{{ sub_title }}</div>
                </td>
                <td class="header-right-col">
                </td>
            </tr>
        </table>
    </div>
    {% endif %}


    <!-- Main Report Content -->
    <div class="content-container {% block container_class %}{% endblock %}">
        {% block content %}{% endblock %}
    </div>
</body>
</html>
