{# Macro to render standard entries loop layout. #}
{% macro render_standard_entry_row(entry, is_zebra, show_dq_lines=false) %}
    <tr class="entry-row {% if is_zebra %}zebra-row{% endif %} {% if show_dq_lines %}dotted-row{% endif %}">
        <td class="col-lane">{{ entry.lane }}</td>
        <td class="col-name">
            <span class="swimmer-name-text">{{ entry.name }}</span>
            {% if entry.age %}<span class="swimmer-age">{{ entry.age }}</span>{% endif %}
        </td>
        <td class="col-team">{{ entry.team }}</td>
        <td class="col-seed">{{ entry.time }}</td>
        {% if show_dq_lines %}
        <td class="col-dq border-left"></td>
        {% endif %}
    </tr>
{% endmacro %}

{# Macro to render relay swimmers in a 2x2 grid #}
{% macro render_relay_swimmers_row(entry, is_zebra, colspan=4, show_dq_lines=false) %}
    {% if entry.is_relay and entry.swimmers %}
    <tr class="relay-swimmers-row {% if is_zebra %}zebra-row{% endif %} {% if show_dq_lines %}dotted-row{% endif %}">
        <td class="col-lane"></td>
        <td colspan="{{ colspan - 1 }}" class="relay-names-cell">
            <div class="relay-grid">
                <div class="relay-col">
                    <div class="relay-swimmer">1) {{ entry.swimmers[0] if entry.swimmers|length > 0 else '' }}</div>
                    <div class="relay-swimmer">3) {{ entry.swimmers[2] if entry.swimmers|length > 2 else '' }}</div>
                </div>
                <div class="relay-col">
                    <div class="relay-swimmer">2) {{ entry.swimmers[1] if entry.swimmers|length > 1 else '' }}</div>
                    <div class="relay-swimmer">4) {{ entry.swimmers[3] if entry.swimmers|length > 3 else '' }}</div>
                </div>
            </div>
        </td>
        {% if show_dq_lines %}
        <td class="col-dq border-left"></td>
        {% endif %}
    </tr>
    {% endif %}
{% endmacro %}

{# Macro to render the DQ lines for Stroke and Turn Judge Reports (UNUSED - replaced by condensed) #}
{% macro render_dq_lines_row() %}
{% endmacro %}
