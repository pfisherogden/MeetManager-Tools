{% extends "_base_report.j2" %}
{% import "_macros.j2" as macros %}

{% block container_class %}timer-sheet-content{% endblock %}

{% block extra_css %}
    .timer-sheet-content {
        column-count: 1 !important;
    }
    .group-block {
        page-break-after: always;
        break-after: page;
    }
    .timer-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10pt;
    }
    .timer-table th {
        border: 1px solid #333;
        padding: 4pt;
        font-size: 9pt;
        background-color: #eee;
        text-align: center;
    }
    .timer-table td {
        border: 1px solid #333;
        padding: 6pt 4pt;
        height: 60pt; /* Large height for writing */
        vertical-align: middle;
    }
    .col-ev-ht { width: 40pt; text-align: center; }
    .col-name-team { width: auto; }
    .col-seed { 
        width: 60pt; 
        text-align: center; 
        font-family: monospace; 
        font-weight: bold;
        font-size: 11pt;
    }
    .col-timer { width: 70pt; }
    
    .swimmer-name {
        font-weight: bold;
        font-size: 11pt;
        display: block;
    }
    .team-name {
        font-size: 9pt;
        color: #555;
        display: block;
        margin-top: 2pt;
    }
{% endblock %}

{% block content %}
    {% for group in groups %}
    <div class="group-block">
        <h2 class="lane-header">{{ group.header }}</h2>
        
        <table class="timer-table">
            <thead>
                <tr>
                    <th class="col-ev-ht">Ev/Ht</th>
                    <th class="col-name-team">Swimmer / Team</th>
                    <th class="col-seed">Seed Time</th>
                    <th class="col-timer">Timer 1</th>
                    <th class="col-timer">Timer 2</th>
                    <th class="col-timer">Stopwatch</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in group.sub_items %}
                <tr class="timer-row">
                    <td class="col-ev-ht">{{ entry.event_num }} / {{ entry.heat }}</td>
                    <td class="col-name-team">
                        <span class="swimmer-name">{{ entry.name }}</span>
                        <span class="team-name">{{ entry.team }}</span>
                        
                        {% if entry.is_relay %}
                        <div class="relay-swimmers" style="margin-top: 4pt;">
                            {{ macros.render_relay_swimmers_row(entry, is_zebra=false, colspan=5) }}
                        </div>
                        {% endif %}
                    </td>
                    <td class="col-seed">{{ entry.time }}</td>
                    <td class="col-timer"></td>
                    <td class="col-timer"></td>
                    <td class="col-timer"></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endfor %}
{% endblock %}
