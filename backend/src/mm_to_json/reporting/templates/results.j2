{% extends "_base_report.j2" %}

{% block extra_css %}
    .group-block {
        break-inside: avoid;
        margin-bottom: 10pt;
        border-bottom: 1px solid #eee;
        padding-bottom: 5pt;
    }
    .group-header {
        font-weight: bold;
        font-size: 10.5pt;
        margin-bottom: 3pt;
        background-color: #f9f9f9;
        padding: 2pt 4pt;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 8.5pt;
    }
    th {
        text-align: left;
        border-bottom: 1px solid #333;
        padding: 1pt 2pt;
        font-size: 7.5pt;
    }
    td {
        padding: 2pt;
    }
    .col-place { width: 22pt; text-align: center; }
    .col-name { width: auto; }
    .col-age { width: 22pt; text-align: center; }
    .col-team { width: 110pt; }
    .col-time { width: 55pt; text-align: right; font-weight: bold; }
    .col-pts { width: 30pt; text-align: right; }
{% endblock %}

{% block content %}
    {% for group in groups %}
    <div class="group-block">
        <div class="group-header">{{ group.header }}</div>
        <table>
            <thead>
                <tr>
                    <th class="col-place">Pl</th>
                    <th class="col-name">Name</th>
                    <th class="col-age">Age</th>
                    <th class="col-team">Team</th>
                    <th class="col-time">Time</th>
                    <th class="col-pts">Pts</th>
                </tr>
            </thead>
            <tbody>
                {% for item in group.sub_items %}
                <tr class="{% if zebra_striping and loop.index is even %}zebra-row{% endif %}">
                    <td class="col-place">{{ item.place }}</td>
                    <td class="col-name">{{ item.name }}</td>
                    <td class="col-age">{{ item.age }}</td>
                    <td class="col-team">{{ item.team }}</td>
                    <td class="col-time">
                        {{ item.time }}
                        {% if item.status == 'DQ' and item.dq_code %}
                            ({{ item.dq_code }})
                        {% endif %}
                    </td>
                    <td class="col-pts">{{ item.points }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endfor %}
{% endblock %}
