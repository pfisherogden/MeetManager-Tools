{% extends "_base_report.j2" %}

{% block extra_css %}
    .group-block {
        break-inside: avoid;
        margin-bottom: 12pt;
    }
    .group-header {
        background-color: #f0f0f0;
        font-weight: bold;
        font-size: 11pt;
        padding: 4pt 8pt;
        border: 1px solid #ccc;
        margin-bottom: 5pt;
        break-after: avoid;
    }
    .entries-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10pt;
    }
    .entries-table th {
        text-align: left;
        border-bottom: 1pt solid #000;
        font-size: 8pt;
        text-transform: uppercase;
        padding: 2pt;
    }
    .col-idx { width: 25pt; text-align: center; font-weight: bold; }
    .col-name { width: auto; }
    .col-team { width: 80pt; font-size: 9pt; }
    .col-age { width: 30pt; text-align: center; }
    .col-time { width: 60pt; text-align: right; font-weight: bold; }
{% endblock %}

{% block content %}
    <div class="{% if columns_on_page == 2 %}columns-2{% endif %}">
    {% for group in groups %}
    <div class="group-block">
        <div class="group-header">{{ group.header }}</div>
        <table class="entries-table">
            <thead>
                <tr>
                    <th class="col-idx">#</th>
                    <th class="col-name">Name</th>
                    <th class="col-age">Age</th>
                    <th class="col-team">Team</th>
                    <th class="col-time">Seed Time</th>
                </tr>
            </thead>
            <tbody>
                {% for athlete in group.sub_items %}
                <tr class="entry-row {% if zebra_striping and loop.index is even %}zebra-row{% endif %}">
                    <td class="col-idx">{{ loop.index }}</td>
                    <td class="col-name">{{ athlete.name }}</td>
                    <td class="col-age">{{ athlete.age if athlete.age != '0' else '' }}</td>
                    <td class="col-team">
                        {% if athlete.team_color %}
                        <span class="team-dot" style="background-color: {{ athlete.team_color }};"></span>
                        {% endif %}
                        {{ athlete.team }}
                    </td>
                    <td class="col-time">{{ athlete.time }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endfor %}
    </div>
{% endblock %}
