{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MM-Tools",
	"version": "0.1.0",
	"identifier": "com.mmtools.desktop",
	"build": {
		"frontendDist": "../out",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npx cross-env EXPORT_STATIC=true NEXT_PUBLIC_AUTH_DISABLED=true npm run build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "MeetManager Tools",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/mmtools-backend"],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
